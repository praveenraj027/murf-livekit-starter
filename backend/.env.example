# =============================================================================
# Backend environment variables — copy to .env.local and fill in real values.
# =============================================================================

# -----------------------------------------------------------------------------
# LiveKit (real-time transport)
# Get these from https://cloud.livekit.io/ → your project → Settings
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# -----------------------------------------------------------------------------
# Outbound calling (Day 6) — SIP outbound trunk id
# Create it once with `lk sip outbound create`, pointed at a telephony provider
# (e.g. a Twilio elastic SIP trunk). Starts with "ST_". Only needed to place
# outbound calls; inbound/browser sessions work without it.
# See the backend README, "Outbound Calls (Day 6)".
# -----------------------------------------------------------------------------
SIP_OUTBOUND_TRUNK_ID=ST_your_outbound_trunk_id_here

# SIP service to place calls through — only needed to RUN setup_trunk.py once,
# which creates the LiveKit outbound trunk above. Not read at call time.
# Linphone (simplest, free): ADDRESS=sip.linphone.org, USERNAME/PASSWORD = a free
#   linphone.org account, NUMBER = any label.
# Twilio (real PSTN): ADDRESS = your Termination URI host, USERNAME/PASSWORD = the
#   Termination credential, NUMBER = your Twilio number in E.164.
SIP_PROVIDER_ADDRESS=sip.linphone.org
SIP_PROVIDER_USERNAME=your_sip_username
SIP_PROVIDER_PASSWORD=your_sip_password
SIP_PROVIDER_NUMBER=dhansaathi

# -----------------------------------------------------------------------------
# Human-help escalations (Day 7) — optional webhook sink
# When the agent raises a request for a real person, it also POSTs a short,
# redacted summary here (never a transcript, never an OTP/PIN/account number).
# A Discord or Slack incoming-webhook URL works out of the box; any endpoint
# that accepts JSON does too. Leave it unset to rely only on the local
# escalations.db + the help-desk dashboard (uv run python src/dashboard.py).
# -----------------------------------------------------------------------------
# ESCALATION_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# -----------------------------------------------------------------------------
# Murf (TTS — Text-to-Speech)
# Get your API key from https://murf.ai/api/dashboard
# -----------------------------------------------------------------------------
MURF_API_KEY=your_murf_api_key_here

# -----------------------------------------------------------------------------
# Deepgram (STT — Speech-to-Text)
# Get your API key from https://deepgram.com
# -----------------------------------------------------------------------------
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# -----------------------------------------------------------------------------
# LLM — use one of the following depending on which provider you use
# -----------------------------------------------------------------------------
# For Gemini (default): get from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# For OpenAI: get from https://platform.openai.com/api-keys (if using OpenAI LLM)
# OPENAI_API_KEY=your_openai_api_key_here
